# Public backend configuration. Production requires NODE_ENV, CLIENT_ORIGIN,
# and CLIENT_BASE_URL. Both client URLs must use HTTPS and must not be localhost.
PORT=
NODE_ENV=
CLIENT_ORIGIN=
CLIENT_BASE_URL=

# Production requires all DB_* connection fields. DB_SSL_* remains provider-specific.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=cyberly
DB_SSL_MODE=disabled
DB_SSL_CA=
DB_SSL_REJECT_UNAUTHORIZED=true

# Production requires a unique SESSION_SECRET of at least 32 characters.
# Use SESSION_COOKIE_SAMESITE=lax for sibling app/api subdomains.
SESSION_NAME=
SESSION_TTL_SECONDS=
SESSION_COOKIE_SAMESITE=lax
SESSION_SECRET=

# EMAIL_TRANSPORT=smtp conditionally requires all SMTP_* fields and EMAIL_FROM_ADDRESS.
# Disabled/test transports do not require live SMTP credentials.
EMAIL_TRANSPORT=disabled
EMAIL_FROM_NAME=Cyberly
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=

ILMU_API_KEY=
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=nemo-super
# Required for the accepted external-Beta CyberGuard runtime. Backend secret store only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DEFAULT_PROVIDER=openai
AI_DEFAULT_MODEL=gpt-5.4-mini
AI_PROVIDER_CYBERGUARD=openai
AI_PROVIDER_AGENT_ROUTER=openai
AI_PROVIDER_LIGHTWEIGHT=openai
AI_PROVIDER_TRANSLATION=openai
AI_PROVIDER_SAFETY=openai
AI_PROVIDER_RUNTIME_DISABLED=gemini
AI_PROVIDER=openai
AI_MODEL=gpt-5.4-mini
AI_TIMEOUT_MS=20000
AI_MAX_OUTPUT_TOKENS=800
AI_CONTEXT_MESSAGE_LIMIT=12
AI_CONTEXT_CHARACTER_LIMIT=8000
AI_PER_USER_MINUTE_LIMIT=6
AI_PER_USER_DAILY_LIMIT=60
AI_GENERATION_STALE_MS=60000
AI_DAILY_BUDGET_USD=
ACTION_PROPOSAL_TTL_SECONDS=180
